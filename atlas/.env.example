# ---------------------------------------------------------------------------
# Modo da camada de dados do app mobile.
#   mock -> adapters em memória (Fase 0, apresentação a stakeholders)
#   http -> adapters HTTP contra a API .NET
# Trocar este valor NAO pode exigir alteracao em nenhuma tela. Ver ADR-0014.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=http://localhost:5080
EXPO_PUBLIC_MOCK_LATENCY_MS=220
EXPO_PUBLIC_MOCK_ERROR_RATE=0
